{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.pedestal/pedestal.service {:mvn/version "0.8.2"}
        io.pedestal/pedestal.jetty {:mvn/version "0.8.2"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        com.cognitect/transit-clj {:mvn/version "1.1.363"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.18"}
        tactrix-reader/device {:local/root "../../lib/device"}}
 :aliases
 {:run {:main-opts ["-m" "tactrix-reader.engine-server.main"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "tactrix-reader.engine-server.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}}}
