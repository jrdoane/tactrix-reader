{:source-paths ["src" "test"]
 :dependencies [[reagent/reagent "2.0.1"]
                [re-frame/re-frame "1.4.7"]
                [com.cognitect/transit-cljs "0.8.280"]]
 :builds {:app {:target :browser
                ;; Served by the Pedestal server at /assets/js.
                :output-dir "../../services/engine-server/resources/public/assets/js"
                :asset-path "/assets/js"
                :modules {:main {:init-fn tactrix-reader.dashboard.core/init}}
                :devtools {:after-load tactrix-reader.dashboard.core/mount}}
          ;; `npm test`: the pure namespaces' tests, run with node.
          :test {:target :node-test
                 :output-to "out/test.js"
                 :ns-regexp "-test$"
                 :autorun false}}}
